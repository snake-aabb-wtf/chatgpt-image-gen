 history.\\n- Outline pull request requirements (descriptions, linked issues, screenshots, etc.).\\n\\n(Optional) Add other sections if relevant, such as Security & Configuration Tips, Architecture Overview, or Agent-Specific Instructions.\\n'}),nDj:(function(e,t,a){e.exports=a.p+\"assets/appshot-logo.f0152cb4dd.png\"}),hIA:(function(e,t,a){e.exports=a.p+\"assets/codex-app-ga-logo.dfddfb85d7.png\"}),jZW:(function(e,t,a){e.exports=a.p+\"assets/dictation-error.f54db4f9bb.wav\"}),OCv:(function(e,t,a){e.exports=a.p+\"assets/dictation-start.f6efcb404f.wav\"}),DJ2:(function(e,t,a){e.exports=a.p+\"assets/dictation-stop.e3bc7ebc5e.wav\"}),tnM:(function(e,t,a){e.exports=a.p+\"assets/arbor.en.25550aca.c30b49fa2d.wav\"}),W5Y:(function(e,t,a){e.exports=a.p+\"assets/breeze.en.da5035ec.3b5cddd7e8.wav\"}),hZW:(function(e,t,a){e.exports=a.p+\"assets/cove.en.9d1a95cf.e2317d0f83.wav\"}),we:(function(e,t,a){e.exports=a.p+\"assets/ember.en.6c36df71.17b9737fed.wav\"}),k0m:(function(e,t,a){e.exports=a.p+\"assets/juniper.en.9ee0561e.1a3ed0a898.wav\"}),DXL:(function(e,t,a){e.exports=a.p+\"assets/maple.en.7e717dcb.53b0250d66.wav\"}),gjv:(function(e,t,a){e.exports=a.p+\"assets/sol.en.8a12cdaa.85c41fda35.wav\"}),do2:(function(e,t,a){e.exports=a.p+\"assets/spruce.en.b3269a2b.4c816d97f0.wav\"}),fam:(function(e,t,a){e.exports=a.p+\"assets/vale.en.2eb74006.20c556c99f.wav\"}),VHr:(function(e,t,a){e.exports=a.p+\"assets/button_down.8803d5f74b.ogg\"}),Te:(function(e,t,a){e.exports=a.p+\"assets/button_up_off.06261b0fb5.ogg\"}),Aeb:(function(e,t,a){e.exports=a.p+\"assets/button_up_on.46492cae6a.ogg\"}),eXF:(function(e,t,a){e.exports=a.p+\"assets/connected_2026_05_r2.8938169949.ogg\"}),fr2:(function(e,t,a){e.exports=a.p+\"assets/error.91b4deeb18.ogg\"}),Tqj:(function(e,t,a){e.exports=a.p+\"assets/hangup_2026_04_09.c2ea91851f.ogg\"}),eFo:(function(e,t,a){var r,o=((r={}).CHATGPT_ADS_MANAGER_WIDGET_EVENT_TYPE_UNSPECIFIED=\"CHATGPT_ADS_MANAGER_WIDGET_EVENT_TYPE_UNSPECIFIED\",r.CHATGPT_ADS_MANAGER_WIDGET_EV